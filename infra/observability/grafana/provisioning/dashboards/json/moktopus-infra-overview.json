{
  "title": "Moktopus Gateway Observability",
  "uid": "moktopus-infra",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Gateway RPS (5m)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(moktopus_gateway_http_requests_total[5m])"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Gateway Uptime (s)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "moktopus_gateway_uptime_seconds"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Prometheus Target Up",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Gateway Request Rate",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(moktopus_gateway_http_requests_total[1m])"
        }
      ]
    }
  ]
}
